<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite"
       parallel="tests"
       thread-count="3">

    <test name="Login Tests">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>
    <test name="Employee List Tests">
        <classes>
            <class name="tests.EmployeeListTest"/>
        </classes>
    </test>
    <test name="Add Employee Tests">
        <classes>
            <class name="tests.AddEmployeeTest"/>
        </classes>
    </test>
    <test name="Add User Tests">
        <classes>
            <class name="tests.AddUserTest"/>
        </classes>
    </test>
    <test name="Dashboard Tests">
        <classes>
            <class name="tests.DashboardTest"/>
        </classes>
    </test>
</suite>